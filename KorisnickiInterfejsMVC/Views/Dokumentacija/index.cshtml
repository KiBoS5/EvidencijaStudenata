@model List<KorisnickiInterfejsMVC.Models.StudentDokumentacijaVM>

@{
    ViewBag.Title = "Pregled dokumentacije";
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool jeZaposleni =
        ViewBag.JeZaposleni != null &&
        (bool)ViewBag.JeZaposleni;

    bool jeAdministrator =
        ViewBag.JeAdministrator != null &&
        (bool)ViewBag.JeAdministrator;
}

<style>
    .dokumentacija-tabela-omotac {
        width: 100%;
        overflow-x: auto;
    }

        .dokumentacija-tabela-omotac .tabela {
            min-width: 1100px;
        }

        .dokumentacija-tabela-omotac td {
            vertical-align: top;
        }

    .dokumentacija-napomena {
        min-width: 160px;
        max-width: 300px;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .dokumentacija-student-link {
        color: #1e3a5f;
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    .dokumentacija-datum {
        white-space: nowrap;
    }

    .dokumentacija-objasnjenje {
        margin-top: 16px;
        color: #64748b;
        font-size: 13px;
        line-height: 1.6;
    }
</style>

<div class="okvir">
    <div class="desno-panel">

        <div class="stranica-zaglavlje">
            <h1 class="print-naslov">
                Pregled dokumentacije
            </h1>

            <p class="stranica-opis">
                Pregled zbirnog statusa dokumentacije.
                Kliknite na ime studenta za prikaz pojedinačnih dokumenata.
            </p>
        </div>

        @if (jeAdministrator)
        {
            <div class="alert alert-info">
                Ovo je administratorski pregled.
                Dokumentaciju obrađuju zaposleni.
            </div>
        }

        @if (TempData["Poruka"] != null)
        {
            <div class="alert alert-info" role="status">
                @TempData["Poruka"]
            </div>
        }

        <div class="dokumentacija-tabela-omotac"
             role="region"
             aria-label="Dokumentacija studenata"
             tabindex="0">

            <table class="tabela">
                <thead>
                    <tr>
                        <th scope="col">Student</th>
                        <th scope="col">Broj indeksa</th>
                        <th scope="col">Status</th>
                        <th scope="col">Datum podnošenja</th>
                        <th scope="col">Rezultat provere</th>
                        <th scope="col">Poslednji proverio</th>
                        <th scope="col">Datum poslednje provere</th>
                        <th scope="col">Napomena</th>

                        @if (jeZaposleni)
                        {
                            <th scope="col">Akcija</th>
                        }
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var doc in Model)
                        {
                            <tr>
                                <td>
                                    <a href="@Url.Action(
                                                 "Index",
                                                 "StudentDetalji",
                                                 new { id = doc.StudentID })"
                                       class="dokumentacija-student-link">
                                        <strong>
                                            @doc.StudentIme @doc.StudentPrezime
                                        </strong>
                                    </a>
                                </td>

                                <td>@doc.BrojIndeksa</td>

                                <td>
                                    <span class="badge @GetBadgeClass(doc.StanjeProcesa)">
                                        @doc.StanjeProcesa
                                    </span>
                                </td>

                                <td class="dokumentacija-datum">
                                    @(doc.DatumPodnosenja.HasValue
                                        ? doc.DatumPodnosenja.Value
                                            .ToString("dd.MM.yyyy HH:mm")
                                        : "-")
                                </td>

                                <td>
                                    @if (doc.DokumentacijaIspravna == false)
                                    {
                                        <span class="badge badge-danger">
                                            Postoje neispravni dokumenti
                                        </span>
                                    }
                                    else if (doc.SviDokumentiProvereni &&
                                             doc.DokumentacijaIspravna == true)
                                    {
                                        <span class="badge badge-success">
                                            Ispravna
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">
                                            Provera nije završena
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (doc.ProverioKorisnikID.HasValue)
                                    {
                                        <strong>
                                            @doc.ProverioImeIPrezime
                                        </strong>

                                        if (!string.IsNullOrWhiteSpace(
                                            doc.ProverioKorisnickoIme))
                                        {
                                            <div class="korisnik-meta">
                                                @doc.ProverioKorisnickoIme
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>

                                <td class="dokumentacija-datum">
                                    @(doc.DatumProvere.HasValue
                                        ? doc.DatumProvere.Value
                                            .ToString("dd.MM.yyyy HH:mm")
                                        : "-")
                                </td>

                                <td><div class="dokumentacija-napomena">@(string.IsNullOrWhiteSpace(doc.NapomenaProvere) ? "-" : doc.NapomenaProvere)</div></td>

                                @if (jeZaposleni)
                                {
                                    <td>
                                        <a href="@Url.Action(
                                                     "Index",
                                                     "StudentDetalji",
                                                     new { id = doc.StudentID })"
                                           class="dugme dugme-small">
                                            Obradi dokumente
                                        </a>
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(jeZaposleni ? 9 : 8)"
                                class="prazno-stanje">
                                Nema dostupnih podataka o dokumentaciji.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p class="dokumentacija-objasnjenje">
            Za prijave sa pojedinačnim dokumentima zbirni status
            odnosi se na obavezne dokumente. Poslednji proverio
            označava zaposlenog koji je poslednji proverio jedan
            od njih. Podaci o svakoj proveri dostupni su u detaljima prijave.
        </p>
    </div>
</div>

@functions {
    public string GetBadgeClass(string stanje)
    {
        if (string.IsNullOrWhiteSpace(stanje))
        {
            return "badge-secondary";
        }

        if (stanje.IndexOf(
                "nije ispravna",
                System.StringComparison.OrdinalIgnoreCase) >= 0)
        {
            return "badge-danger";
        }

        if (stanje.IndexOf(
                "Spremna",
                System.StringComparison.OrdinalIgnoreCase) >= 0)
        {
            return "badge-success";
        }

        if (stanje.IndexOf(
                "Čeka proveru",
                System.StringComparison.OrdinalIgnoreCase) >= 0)
        {
            return "badge-info";
        }

        if (stanje.IndexOf(
                "Čeka podnošenje",
                System.StringComparison.OrdinalIgnoreCase) >= 0)
        {
            return "badge-warning";
        }

        return "badge-secondary";
    }
}