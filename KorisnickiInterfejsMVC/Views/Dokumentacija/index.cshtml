@model List<KorisnickiInterfejsMVC.Models.StudentDokumentacijaVM>

@{
    ViewBag.Title = "Provera dokumentacije";
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool jeZaposleni =
        ViewBag.JeZaposleni != null &&
        (bool)ViewBag.JeZaposleni;

    bool jeAdministrator =
        ViewBag.JeAdministrator != null &&
        (bool)ViewBag.JeAdministrator;
}

<style>
    #formaProvere {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        box-sizing: border-box;
        width: calc(100% - 32px);
        max-width: 520px;
        max-height: calc(100vh - 32px);
        overflow-y: auto;
        padding: 28px;
        border: 1px solid #d8e0e8;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 16px 48px rgba(0, 0, 0, 0.25);
        z-index: 1000;
    }

    #pozadina {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.5);
        z-index: 999;
    }

    #formaProvere h2 {
        margin: 0 0 24px;
        color: #1e3a5f;
        font-size: 24px;
    }

    #formaProvere .polje-grupa {
        margin-bottom: 20px;
    }

    #formaProvere .radio-lista {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-top: 12px;
    }

    #formaProvere .radio-opcija {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
        cursor: pointer;
    }

    #formaProvere input[type="radio"] {
        width: 18px;
        height: 18px;
        margin: 0;
        accent-color: #1e3a5f;
    }

    #formaProvere textarea {
        box-sizing: border-box;
        width: 100%;
        margin-top: 8px;
        resize: vertical;
    }

    #formaProvere .modal-akcije {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 24px;
    }

        #formaProvere .modal-akcije .dugme {
            margin: 0;
        }

    #formaProvere .poruka-greske {
        margin-top: 8px;
        color: #b13a3a;
        font-size: 13px;
    }

    .dokumentacija-tabela-omotac {
        width: 100%;
        overflow-x: auto;
    }

        .dokumentacija-tabela-omotac .tabela {
            min-width: 1050px;
        }

    .dokumentacija-napomena {
        min-width: 160px;
        max-width: 300px;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }
</style>

<div class="okvir">
    <div class="desno-panel">

        <div class="stranica-zaglavlje">
            <h1 class="print-naslov">
                Provera dokumentacije
            </h1>

            <p class="stranica-opis">
                Pregled statusa dokumentacije prijavljenih studenata.
            </p>
        </div>

        @if (jeAdministrator)
        {
            <div class="alert alert-info">
                Ovo je administratorski pregled. Dokumentaciju
                mogu obrađivati samo zaposleni.
            </div>
        }

        @if (TempData["Poruka"] != null)
        {
            <div class="alert alert-info" role="status">
                @TempData["Poruka"]
            </div>
        }

        <div class="dokumentacija-tabela-omotac"
             role="region"
             aria-label="Dokumentacija studenata"
             tabindex="0">

            <table class="tabela">
                <thead>
                    <tr>
                        <th scope="col">Student</th>
                        <th scope="col">Broj indeksa</th>
                        <th scope="col">Status</th>
                        <th scope="col">Datum podnošenja</th>
                        <th scope="col">Rezultat provere</th>
                        <th scope="col">Proverio</th>
                        <th scope="col">Datum provere</th>
                        <th scope="col">Napomena</th>

                        @if (jeZaposleni)
                        {
                            <th scope="col">Akcija</th>
                        }
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var doc in Model)
                        {
                            <tr>
                                <td>
                                    <strong>
                                        @doc.StudentIme @doc.StudentPrezime
                                    </strong>
                                </td>

                                <td>@doc.BrojIndeksa</td>

                                <td>
                                    <span class="badge @GetBadgeClass(doc.StanjeProcesa)">
                                        @doc.StanjeProcesa
                                    </span>
                                </td>

                                <td>
                                    @(doc.DatumPodnosenja.HasValue
                                        ? doc.DatumPodnosenja.Value
                                            .ToString("dd.MM.yyyy HH:mm")
                                        : "-")
                                </td>

                                <td>
                                    @if (!doc.SviDokumentiProvereni ||
                                         !doc.DokumentacijaIspravna.HasValue)
                                    {
                                        <span class="badge badge-secondary">
                                            Nije proverena
                                        </span>
                                    }
                                    else if (doc.DokumentacijaIspravna.Value)
                                    {
                                        <span class="badge badge-success">
                                            Ispravna
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">
                                            Nije ispravna
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (doc.ProverioKorisnikID.HasValue)
                                    {
                                        <strong>
                                            @doc.ProverioImeIPrezime
                                        </strong>

                                        if (!string.IsNullOrWhiteSpace(
                                            doc.ProverioKorisnickoIme))
                                        {
                                            <div class="korisnik-meta">
                                                @doc.ProverioKorisnickoIme
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>

                                <td>
                                    @(doc.DatumProvere.HasValue
                                        ? doc.DatumProvere.Value
                                            .ToString("dd.MM.yyyy HH:mm")
                                        : "-")
                                </td>

                                <td><div class="dokumentacija-napomena">@(string.IsNullOrWhiteSpace(doc.NapomenaProvere) ? "-" : doc.NapomenaProvere)</div></td>

                                @if (jeZaposleni)
                                {
                                    <td>
                                        @if (!doc.SviDokumentiPodneseni)
                                        {
                                            using (Html.BeginForm(
                                                "OznaciDokumentacijuPodnetom",
                                                "Dokumentacija",
                                                FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()

                                                @Html.Hidden(
                                                    "studentID",
                                                    doc.StudentID,
                                                    new
                                                    {
                                                        id = "podnosenjeStudentID_" + doc.StudentID
                                                    })

                                                <button type="submit"
                                                        class="dugme dugme-small">
                                                    Označi kao podneto
                                                </button>
                                            }
                                        }
                                        else if (!doc.SviDokumentiProvereni ||
                                                 doc.DokumentacijaIspravna == false)
                                        {
                                            <button type="button"
                                                    class="dugme dugme-small"
                                                    onclick="pokaziFormuProvere(@doc.StudentID, this)">
                                                @(doc.DokumentacijaIspravna == false
                                                    ? "Ponovo proveri"
                                                    : "Proveri")
                                            </button>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(jeZaposleni ? 9 : 8)"
                                class="prazno-stanje">
                                Nema dostupnih podataka o dokumentaciji.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (jeZaposleni)
{
    <div id="pozadina"
         style="display:none;"
         onclick="sakrijFormuProvere()">
    </div>

    <div id="formaProvere"
         style="display:none;"
         role="dialog"
         aria-modal="true"
         aria-labelledby="naslovFormeProvere"
         tabindex="-1">

        <h2 id="naslovFormeProvere">
            Provera dokumentacije
        </h2>

        @using (Html.BeginForm(
            "ProveriDokumentacijuStudenta",
            "Dokumentacija",
            FormMethod.Post,
            new
            {
                id = "formaZaProveru",
                onsubmit = "return validirajProveru();"
            }))
        {
            @Html.AntiForgeryToken()

            @Html.Hidden(
                "studentID",
                0,
                new { id = "modalStudentID" })

            <div class="polje-grupa">
                <strong>Da li je dokumentacija ispravna?</strong>

                <div class="radio-lista">
                    <label class="radio-opcija">
                        <input type="radio"
                               name="dokumentacijaIspravna"
                               value="true"
                               onchange="promeniObaveznostNapomene()" />
                        Ispravna
                    </label>

                    <label class="radio-opcija">
                        <input type="radio"
                               name="dokumentacijaIspravna"
                               value="false"
                               onchange="promeniObaveznostNapomene()" />
                        Nije ispravna
                    </label>
                </div>

                <div id="porukaRezultat"
                     class="poruka-greske"
                     role="alert"
                     style="display:none;">
                    Izaberite rezultat provere.
                </div>
            </div>

            <div class="polje-grupa">
                <label for="napomena">Napomena</label>

                <textarea id="napomena"
                          name="napomena"
                          class="polje-unos"
                          rows="4"
                          maxlength="500"
                          aria-describedby="uputstvoNapomena"
                          placeholder="Unesite napomenu o proveri..."></textarea>

                <small id="uputstvoNapomena">
                    Obavezna kada dokumentacija nije ispravna.
                </small>

                <div id="porukaNapomena"
                     class="poruka-greske"
                     role="alert"
                     style="display:none;">
                    Unesite razlog zbog kog dokumentacija nije ispravna.
                </div>
            </div>

            <div class="modal-akcije">
                <button type="button"
                        class="dugme dugme-cancel"
                        onclick="sakrijFormuProvere()">
                    Otkaži
                </button>

                <button type="submit"
                        class="dugme dugme-success">
                    Sačuvaj proveru
                </button>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        var dugmeOtvaranjaProvere = null;
        var prethodniOverflow = "";

        function pokaziFormuProvere(studentId, dugme) {
            var forma = document.getElementById("formaZaProveru");
            if (!forma) {
                return;
            }

            forma.reset();

            document.getElementById("modalStudentID").value = studentId;
            document.getElementById("porukaRezultat").style.display = "none";
            document.getElementById("porukaNapomena").style.display = "none";

            dugmeOtvaranjaProvere = dugme || document.activeElement;
            prethodniOverflow = document.body.style.overflow;
            document.body.style.overflow = "hidden";

            document.getElementById("pozadina").style.display = "block";
            document.getElementById("formaProvere").style.display = "block";

            forma.querySelector(
                'input[name="dokumentacijaIspravna"]'
            ).focus();
        }

        function sakrijFormuProvere() {
            var prozor = document.getElementById("formaProvere");
            var pozadina = document.getElementById("pozadina");

            if (!prozor || prozor.style.display === "none") {
                return;
            }

            prozor.style.display = "none";

            if (pozadina) {
                pozadina.style.display = "none";
            }

            document.body.style.overflow = prethodniOverflow;

            if (dugmeOtvaranjaProvere) {
                dugmeOtvaranjaProvere.focus();
            }
        }

        function pronadjiIzabraniRezultat() {
            var izabrano = document.querySelector(
                '#formaZaProveru input[name="dokumentacijaIspravna"]:checked'
            );

            return izabrano ? izabrano.value : null;
        }

        function promeniObaveznostNapomene() {
            var rezultat = pronadjiIzabraniRezultat();

            document.getElementById("porukaRezultat").style.display = "none";

            if (rezultat === "true") {
                document.getElementById("porukaNapomena").style.display = "none";
            }
        }

        function validirajProveru() {
            var rezultat = pronadjiIzabraniRezultat();
            var napomena = document.getElementById("napomena");

            document.getElementById("porukaRezultat").style.display = "none";
            document.getElementById("porukaNapomena").style.display = "none";

            if (rezultat === null) {
                document.getElementById("porukaRezultat").style.display = "block";

                document.querySelector(
                    '#formaZaProveru input[name="dokumentacijaIspravna"]'
                ).focus();

                return false;
            }

            if (rezultat === "false" && napomena.value.trim().length === 0) {
                document.getElementById("porukaNapomena").style.display = "block";
                napomena.focus();
                return false;
            }

            return true;
        }

        document.addEventListener("keydown", function (event) {
            var prozor = document.getElementById("formaProvere");

            if (!prozor || prozor.style.display === "none") {
                return;
            }

            if (event.key === "Escape") {
                event.preventDefault();
                sakrijFormuProvere();
                return;
            }

            if (event.key === "Tab") {
                var elementi = prozor.querySelectorAll(
                    'button:not([disabled]), input:not([type="hidden"]):not([disabled]), textarea:not([disabled])'
                );

                var prvi = elementi[0];
                var poslednji = elementi[elementi.length - 1];

                if (event.shiftKey && document.activeElement === prvi) {
                    event.preventDefault();
                    poslednji.focus();
                } else if (!event.shiftKey &&
                    document.activeElement === poslednji) {
                    event.preventDefault();
                    prvi.focus();
                }
            }
        });
    </script>
}

@functions {
    public string GetBadgeClass(string stanje)
    {
        if (string.IsNullOrWhiteSpace(stanje))
        {
            return "badge-secondary";
        }

        if (stanje.IndexOf(
                "nije ispravna",
                System.StringComparison.OrdinalIgnoreCase) >= 0)
        {
            return "badge-danger";
        }

        if (stanje.IndexOf(
                "Spremna",
                System.StringComparison.OrdinalIgnoreCase) >= 0)
        {
            return "badge-success";
        }

        if (stanje.IndexOf(
                "Čeka proveru",
                System.StringComparison.OrdinalIgnoreCase) >= 0)
        {
            return "badge-info";
        }

        if (stanje.IndexOf(
                "Čeka podnošenje",
                System.StringComparison.OrdinalIgnoreCase) >= 0)
        {
            return "badge-warning";
        }

        return "badge-secondary";
    }
}