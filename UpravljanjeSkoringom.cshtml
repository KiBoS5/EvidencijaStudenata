@model KorisnickiInterfejsMVC.Models.SkoringKonfiguraciaVM

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="okvir">
    <div class="levo-panel">
        <div class="sekcija-kutija">
            <div class="naslov-sekcije">?? Uputstvo</div>
            <p>Ova strana omogu?ava vam da prilagodite pondere i prag za bodovanje studenata.</p>
            <p><strong>GPA bodovi:</strong> Minimalno 10, maksimalno 20 bodova.</p>
            <p><strong>Finansijski status:</strong> Raspon od 1-10 bodova na osnovu primanja po ?lanu doma?instva.</p>
            <p><strong>Godina studija:</strong> 2-10 bodova zavisno od godine.</p>
        </div>
    </div>

    <div class="desno-panel">
        <div class="print-naslov">Upravljanje skoringom stipendije</div>

        @if (TempData["Poruka"] != null)
        {
            <div class="alert alert-info">@TempData["Poruka"]</div>
        }

        @using (Html.BeginForm("UpravljanjeSkoringom", "Admin", FormMethod.Post))
        {
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="forma-sekcija">
                <h3>?? GPA bodovanje</h3>
                
                <div class="forma-red">
                    <label>Minimalan prosek za u?eš?e:</label>
                    @Html.TextBoxFor(x => x.MinimalanProsek, new { @class = "polje-unos", type = "number", step = "0.01" })
                </div>

                <div class="forma-red">
                    <label>GPA za 10 bodova (od):</label>
                    @Html.TextBoxFor(x => x.ProsekZa10Bodova, new { @class = "polje-unos", type = "number", step = "0.01" })
                </div>

                <div class="forma-red">
                    <label>GPA za 15 bodova (od):</label>
                    @Html.TextBoxFor(x => x.ProsekZa15Bodova, new { @class = "polje-unos", type = "number", step = "0.01" })
                </div>

                <div class="forma-red">
                    <label>GPA za 20 bodova (od):</label>
                    @Html.TextBoxFor(x => x.ProsekZa20Bodova, new { @class = "polje-unos", type = "number", step = "0.01" })
                </div>
            </div>

            <div class="forma-sekcija">
                <h3>?? Financijski status (primanja po ?lanu doma?instva)</h3>
                
                <div class="forma-red">
                    <label>Primanja za 10 bodova (do):</label>
                    @Html.TextBoxFor(x => x.PrimanjaZa10Bodova, new { @class = "polje-unos", type = "number", step = "0.01" })
                </div>

                <div class="forma-red">
                    <label>Primanja za 1 bod (od):</label>
                    @Html.TextBoxFor(x => x.PrimanjaZa1Bod, new { @class = "polje-unos", type = "number", step = "0.01" })
                </div>

                <div class="forma-red">
                    <label>Multiplikator za studente bez roditelja:</label>
                    @Html.TextBoxFor(x => x.BezRoditeljaMultiplier, new { @class = "polje-unos", type = "number", step = "0.01", min = "0.1", max = "1.0" })
                </div>
            </div>

            <div class="forma-sekcija">
                <h3>?? Bodovanje po godini studija</h3>
                
                <div class="forma-red">
                    <label>1. godina:</label>
                    @Html.TextBoxFor(x => x.BodoviGodinaStudije1, new { @class = "polje-unos", type = "number", min = "0", max = "20" })
                </div>

                <div class="forma-red">
                    <label>2. godina:</label>
                    @Html.TextBoxFor(x => x.BodoviGodinaStudije2, new { @class = "polje-unos", type = "number", min = "0", max = "20" })
                </div>

                <div class="forma-red">
                    <label>3. godina:</label>
                    @Html.TextBoxFor(x => x.BodoviGodinaStudije3, new { @class = "polje-unos", type = "number", min = "0", max = "20" })
                </div>

                <div class="forma-red">
                    <label>4. godina:</label>
                    @Html.TextBoxFor(x => x.BodoviGodinaStudije4, new { @class = "polje-unos", type = "number", min = "0", max = "20" })
                </div>

                <div class="forma-red">
                    <label>Master / PhD:</label>
                    @Html.TextBoxFor(x => x.BodoviMaster, new { @class = "polje-unos", type = "number", min = "0", max = "20" })
                </div>
            </div>

            <button type="submit" class="dugme dugme-success">?? Sa?uvaj konfiguraciju</button>
        }
    </div>
</div>
